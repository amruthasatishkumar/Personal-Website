---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";

export async function getStaticPaths() {
  const courses = await getCollection("courses", ({ data }) => !data.draft);
  return courses.map((course) => ({
    params: { course: course.data.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);

const lessons = (
  await getCollection(
    "lessons",
    ({ data }) => !data.draft && data.course === course.data.slug
  )
).sort((a, b) => a.data.order - b.data.order);

const courseUrl = new URL(`/learn/${course.data.slug}`, site.url).href;

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: course.data.title,
  description: course.data.description || course.data.outcome,
  url: courseUrl,
  provider: { "@type": "Person", name: site.name, url: site.url },
  educationalLevel: course.data.level,
  isAccessibleForFree: course.data.access === "free",
  hasCourseInstance: [
    {
      "@type": "CourseInstance",
      courseMode: "online",
      courseWorkload: `PT${Math.max(lessons.length, 1)}H`,
    },
  ],
  ...(lessons.length
    ? {
        hasPart: lessons.map((l) => ({
          "@type": "LearningResource",
          name: l.data.title,
          url: new URL(`/learn/${course.data.slug}/${l.data.slug}`, site.url).href,
        })),
      }
    : {}),
};
---

<BaseLayout
  title={course.data.title}
  description={course.data.description || course.data.outcome}
  image={course.data.cover ?? "/og-default.png"}
>
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} is:inline />

  <section class="mx-auto max-w-5xl px-4 pt-14 sm:pt-20">
    <a href="/learn" class="text-sm text-[var(--text-muted)] hover:text-[var(--text)]">← All courses</a>

    <header class="mt-6">
      <p class="eyebrow">
        {course.data.level} · {lessons.length} lessons{course.data.track ? ` · ${course.data.track}` : ""}
      </p>
      <h1 class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">
        {course.data.title}
      </h1>
      {course.data.outcome && (
        <p class="mt-4 text-lg text-[var(--text-muted)]">{course.data.outcome}</p>
      )}

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <button
          type="button"
          data-enroll
          data-course={course.data.slug}
          class="btn-primary"
        >
          Start course
        </button>
        <span data-progress-label class="text-sm text-[var(--text-faint)]"></span>
        <button
          type="button"
          data-reset
          class="hidden text-sm text-[var(--text-faint)] underline underline-offset-4 hover:text-[var(--text)]"
        >
          Reset progress
        </button>
      </div>
    </header>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div class="prose-glass">
        <Content />
      </div>

      <aside class="space-y-6">
        {course.data.outcomes.length > 0 && (
          <div class="glass rounded-2xl p-6">
            <h2 class="font-display text-lg font-bold">What you'll walk away with</h2>
            <ul class="mt-4 space-y-2 text-sm text-[var(--text-muted)]">
              {course.data.outcomes.map((o) => (
                <li class="flex gap-2"><span class="text-gradient">✓</span><span>{o}</span></li>
              ))}
            </ul>
          </div>
        )}
        {course.data.prerequisites.length > 0 && (
          <div class="glass rounded-2xl p-6">
            <h2 class="font-display text-lg font-bold">Before you start</h2>
            <ul class="mt-4 space-y-2 text-sm text-[var(--text-muted)]">
              {course.data.prerequisites.map((p) => (
                <li class="flex gap-2"><span class="text-[var(--text-faint)]">•</span><span>{p}</span></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  <section class="mx-auto mt-14 max-w-5xl px-4">
    <h2 class="font-display text-2xl font-bold">Lessons</h2>
    <ol class="mt-6 space-y-3" data-lesson-list data-course={course.data.slug}>
      {lessons.map((l, i) => (
        <li>
          <a
            href={`/learn/${course.data.slug}/${l.data.slug}`}
            data-lesson-slug={l.data.slug}
            class="glass group flex items-center gap-4 rounded-2xl p-5 transition hover:-translate-y-0.5"
          >
            <span
              data-lesson-check
              data-index={i + 1}
              class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[rgb(var(--surface)/0.18)] text-sm font-semibold text-[var(--text-faint)]"
            >
              {i + 1}
            </span>
            <span class="flex-1">
              <span class="block font-semibold">{l.data.title}</span>
              {l.data.summary && (
                <span class="mt-1 block text-sm text-[var(--text-muted)]">{l.data.summary}</span>
              )}
            </span>
            <span class="text-xs text-[var(--text-faint)]">{l.data.readTime}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <script>
    // No-backend enroll + progress, stored per course in localStorage.
    const list = document.querySelector<HTMLElement>("[data-lesson-list]");
    const courseSlug = list?.dataset.course ?? "";
    const enrollKey = `course:${courseSlug}:enrolled`;
    const doneKey = `course:${courseSlug}:done`;
    const completedKey = `course:${courseSlug}:completed`;

    const readDone = (): string[] => {
      try {
        return JSON.parse(localStorage.getItem(doneKey) || "[]");
      } catch {
        return [];
      }
    };

    const paint = () => {
      const done = readDone();
      const rows = document.querySelectorAll<HTMLElement>("[data-lesson-slug]");
      rows.forEach((row) => {
        const slug = row.dataset.lessonSlug!;
        const badge = row.querySelector<HTMLElement>("[data-lesson-check]");
        if (!badge) return;
        if (done.includes(slug)) {
          badge.textContent = "✓";
          badge.classList.add("text-gradient");
        } else {
          // Restore the original number so undo/reset repaints correctly.
          badge.textContent = badge.dataset.index ?? "";
          badge.classList.remove("text-gradient");
        }
      });
      const label = document.querySelector<HTMLElement>("[data-progress-label]");
      const total = rows.length;
      const enrolled = localStorage.getItem(enrollKey) === "1";
      const completed =
        localStorage.getItem(completedKey) === "1" ||
        (total > 0 && done.length >= total);
      const btn = document.querySelector<HTMLElement>("[data-enroll]");
      if (btn) {
        if (completed) {
          btn.textContent = "Completed ✓";
          btn.classList.remove("btn-primary");
          btn.classList.add("btn-complete");
        } else {
          btn.textContent = enrolled ? "Continue course" : "Start course";
          btn.classList.remove("btn-complete");
          btn.classList.add("btn-primary");
        }
      }
      if (label) {
        label.classList.remove("text-complete");
        if (completed) {
          label.textContent = "✓ Course completed";
          label.classList.add("text-complete");
        } else if (done.length > 0) {
          label.textContent = `${done.length} of ${total} lessons done`;
        } else if (enrolled) {
          label.textContent = "Enrolled · no lessons finished yet";
        } else {
          label.textContent = "Free · no signup, progress saves on this device";
        }
      }
      const reset = document.querySelector<HTMLElement>("[data-reset]");
      if (reset) {
        const hasProgress = enrolled || completed || done.length > 0;
        reset.classList.toggle("hidden", !hasProgress);
      }
    };

    document.querySelector<HTMLElement>("[data-enroll]")?.addEventListener("click", () => {
      // If already completed, the button is a review link; otherwise it enrolls.
      localStorage.setItem(enrollKey, "1");
      const first = document.querySelector<HTMLAnchorElement>("[data-lesson-slug]");
      if (first) window.location.href = first.href;
    });

    document.querySelector<HTMLElement>("[data-reset]")?.addEventListener("click", () => {
      if (!confirm("Reset your progress for this course? This clears your completed and done marks on this device.")) return;
      localStorage.removeItem(enrollKey);
      localStorage.removeItem(doneKey);
      localStorage.removeItem(completedKey);
      paint();
    });

    paint();
  </script>
</BaseLayout>
